# Copy to backend/.env and fill in what you have. Every value is optional -
# the app boots and runs without any of them.

# --- database ---------------------------------------------------------------
# Created automatically on first start. Change only if you want it elsewhere.
# DATABASE_URL=sqlite:///./korea_jobs.db

# --- official open-API keys (free, no scraping involved) --------------------
# Saramin:  https://oapi.saramin.co.kr/    (사람인 오픈 API)
# Work24:   https://www.work24.go.kr/      (고용24 오픈 API 신청)
# A collector without its key reports itself as "unavailable" and the rest of
# the search carries on.
SARAMIN_API_KEY=
WORK24_API_KEY=

# --- demo mode --------------------------------------------------------------
# false (default) = a source that is unconfigured or failing reports the real
#         reason (not_configured / invalid_key / rate_limited / ...) and returns
#         nothing. Real data is never silently replaced.
# true  = those sources are stood in for with clearly labelled sample data
#         (is_mock=true, "DEMO" badge). Only for demoing the UI without keys.
DEMO_MODE=false

# --- networking -------------------------------------------------------------
# REQUEST_TIMEOUT=10
# COLLECTOR_TIMEOUT=20
# MAX_RESULTS_PER_COLLECTOR=50
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
