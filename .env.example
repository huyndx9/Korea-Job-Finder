# ============================================================
#  VietJob Korea AI — Environment Configuration
#  Copy file này thành `.env` rồi điền giá trị thật.
#  KHÔNG BAO GIỜ commit file `.env`.
# ============================================================

# ---- Application ----
# development | test | production
APP_ENV=development
APP_NAME=VietJob Korea AI
APP_DEBUG=true

# Chế độ 1 người dùng: bỏ qua đăng nhập, mọi request thuộc về local owner.
# App sẽ TỪ CHỐI khởi động nếu APP_ENV=production và giá trị này = true.
SINGLE_USER_MODE=true

# Ở single-user mode server chỉ bind loopback vì không có authentication.
API_HOST=127.0.0.1
API_PORT=8000

# Chỉ đặt true khi chạy trong container (tiến trình bắt buộc bind 0.0.0.0) VÀ
# cổng đã được giới hạn ở tầng khác, ví dụ publish dạng 127.0.0.1:8000:8000.
# Đặt true khi cổng mở ra toàn mạng = để ngỏ toàn bộ dữ liệu, không có đăng nhập.
SINGLE_USER_ALLOW_EXTERNAL_BIND=false

# Frontend origin cho CORS (phân tách bằng dấu phẩy)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# ---- Database (MySQL 8.0) ----
# Định dạng: mysql+asyncmy://<user>:<password>@<host>:<port>/<database>?charset=utf8mb4
# Chạy `scripts/mysql_setup.sql` trước để tạo database và user.
# Nếu password có ký tự đặc biệt (@ : / ?) thì phải URL-encode.
DATABASE_URL=mysql+asyncmy://vietjob:CHANGE_ME@127.0.0.1:3306/vietjob?charset=utf8mb4

# Database riêng cho test — SẼ BỊ XÓA SẠCH mỗi lần chạy test.
# Bắt buộc phải khác DATABASE_URL, app sẽ chặn nếu trùng.
TEST_DATABASE_URL=mysql+asyncmy://vietjob:CHANGE_ME@127.0.0.1:3306/vietjob_test?charset=utf8mb4

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_ECHO=false


# ---- Redis (tuỳ chọn) ----
# Để trống -> dùng ThreadTaskQueue in-process (đủ cho single-user).
# Điền vào -> dùng Celery + Redis.
REDIS_URL=


# ---- AI Provider ----
# anthropic | openai | gemini | local | null
# `null` KHÔNG giả lập kết quả — job sẽ ở trạng thái AI_ANALYSIS_PENDING.
AI_PROVIDER=null

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=3


# ---- Embeddings ----
# local  -> sentence-transformers chạy trên máy, miễn phí, không cần API key
# openai -> text-embedding-3-small (cần OPENAI_API_KEY)
# null   -> tắt semantic search
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384


# ---- Job Sources ----
# Saramin Open API (chính thức) — đăng ký tại https://oapi.saramin.co.kr
SARAMIN_API_KEY=

# WorkNet / data.go.kr Open API (chính thức)
WORKNET_API_KEY=

CRAWLER_USER_AGENT=VietJobKoreaAI/0.1 (+contact: your-email@example.com)
CRAWLER_REQUEST_TIMEOUT=30
CRAWLER_RATE_LIMIT_PER_MINUTE=20
CRAWLER_MAX_RETRIES=3
CRAWLER_RESPECT_ROBOTS_TXT=true


# ---- Resume upload ----
RESUME_STORAGE_DIR=./data/resumes
RESUME_MAX_SIZE_MB=10


# ---- Email / Job Alerts (tuỳ chọn) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true


# ---- Observability ----
# debug | info | warning | error
LOG_LEVEL=info
# json | console
LOG_FORMAT=console
SENTRY_DSN=
