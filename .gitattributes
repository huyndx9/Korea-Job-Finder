# Chuẩn hoá line ending. Không có file này, Git tự chuyển sang CRLF trên
# Windows và Makefile / script shell / Dockerfile sẽ hỏng khi chạy trên Linux.

* text=auto eol=lf

# File chỉ chạy trên Windows thì giữ CRLF.
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Nhị phân — không được đụng vào.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.docx  binary
*.xlsx  binary

# Bỏ qua trong diff của GitHub để review không bị lấp.
package-lock.json linguist-generated=true
